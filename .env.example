# Copia este fichero a .env.local para desarrollo. En producción, todo va en Vercel → Settings → Environment Variables.
# Si falta cualquier variable obligatoria, la app responde 503 a todo (falla cerrada).

# Host y origen canónicos (sin barra final). Cualquier otro host recibe 404.
APP_HOST=localhost:3000
APP_ORIGIN=http://localhost:3000

# Administrador inicial. Se crea solo, sin contraseña, la primera vez.
ADMIN_EMAIL=

# Token de arranque (mín. 32 caracteres): /activar?t=<SETUP_TOKEN> permite al ADMIN_EMAIL
# crear su contraseña UNA sola vez. Después deja de funcionar.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SETUP_TOKEN=

# Redis (Upstash). Vale cualquiera de los dos pares; la integración de Vercel crea KV_REST_API_*.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
