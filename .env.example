# Copia este fichero a .env.local para desarrollo. En producción, todo va en Vercel → Settings → Environment Variables.
# Si falta cualquier variable obligatoria, la app responde 503 a todo (falla cerrada).

# Host y origen canónicos (sin barra final). Cualquier otro host recibe 404.
APP_HOST=localhost:3000
APP_ORIGIN=http://localhost:3000

# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application)
# Redirect URI autorizado: ${APP_ORIGIN}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dominio exacto de Google Workspace (comparación estricta con la claim "hd")
ALLOWED_HD=

# Whitelist de correos autorizados, separados por comas (todos del dominio ALLOWED_HD)
ALLOWED_EMAILS=

# Clave de 32 bytes en base64 para cifrar la cookie temporal de OAuth.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SEAL_KEY=

# Redis (Upstash). Vale cualquiera de los dos pares; la integración de Vercel crea KV_REST_API_*.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Opcional: Cloudflare Access delante (opción B del documento). Si se define, su JWT es obligatorio.
# CF_TEAM_DOMAIN=tu-equipo.cloudflareaccess.com
# CF_ACCESS_AUD=
